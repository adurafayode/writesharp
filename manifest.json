{
    "manifest_version": 3,
    "name": "WriteSharp",
    "version": "1.1.0",
    "description": "AI-assisted writing clarity enhancer for web text areas",
    "permissions": [
      "activeTab",
      "storage",
      "scripting"
    ],
    "host_permissions": [
      "https://*.gmail.com/*",
      "https://*.slack.com/*",
      "https://*.zendesk.com/*",
      "https://*.github.com/*"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.openai.com"
    },
    "background": {
      "service_worker": "src/background.js"
    },
    "content_scripts": [
      {
        "matches": [
          "https://*.gmail.com/*",
          "https://*.slack.com/*",
          "https://*.zendesk.com/*",
          "https://*.github.com/*"
        ],
        "js": ["src/content.js"],
        "run_at": "document_end"
      },
      {
        "matches": ["https://*.zendesk.com/*"],
        "js": ["src/zendesk-handler.js"],
        "run_at": "document_end"
      }
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "icons/*.png", 
          "src/public/popup/popup.css", 
          "src/public/popup/popup.html",
          "src/zendesk-helper.js"
        ],
        "matches": [
          "https://*.gmail.com/*",
          "https://*.slack.com/*",
          "https://*.zendesk.com/*",
          "https://*.github.com/*"
        ]
      }
    ],
    "action": {
      "default_popup": "src/public/popup/popup.html",
      "default_icon": {
        "16": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
      }
    },
    "icons": {
      "16": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }


