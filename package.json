{
    "name": "writesharp",
    "version": "1.1.0",
    "description": "Chrome extension for AI-assisted writing improvement",
    "main": "src/background.js",
    "scripts": {
        "build": "zip -r dist/writesharp.zip . -x \"dist/*\" \"node_modules/*\" \".*\" \"Archive.zip\" \"repomix-output.txt\""
    },
    "dependencies": {},
    "devDependencies": {},
    "jest": {
        "testEnvironment": "jsdom",
        "moduleFileExtensions": [
            "js",
            "json"
        ],
        "transform": {},
        "testMatch": [
            "**/__tests__/**/*.js",
            "**/?(*.)+(spec|test).js"
        ],
        "setupFiles": [
            "<rootDir>/jest.setup.js"
        ],
        "testPathIgnorePatterns": [
            "/node_modules/",
            "src/public/test.js"
        ]
    },
    "keywords": [
        "chrome-extension",
        "writing",
        "ai",
        "text-improvement"
    ],
    "author": "Adurex <israel.fayode@gmail.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/adurafayode/writesharp.git"
    },
    "bugs": {
        "url": "https://github.com/adurafayode/writesharp/issues"
    },
    "homepage": "https://github.com/adurafayode/writesharp#readme"
}
